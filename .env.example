# ==============================================================================
# Portfolio Environment Variables
# ==============================================================================

# Supabase (Database & Server Operations)
# Project URL (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-side ONLY - Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (Transactional Email Service)
# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Sender Address (e.g. "onboarding@resend.dev" for sandbox or verified domain)
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Recipient Email Address where contact inquiries are forwarded
EMAIL_TO=info.imran.ma@gmail.com

# Legacy environment variable aliases (supported for backward compatibility)
CONTACT_EMAIL=info.imran.ma@gmail.com
EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>
